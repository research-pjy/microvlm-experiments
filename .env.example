# Copy to `.env` in the project root. Keys are loaded by `microvlm.utils.api_keys`
# and passed explicitly into teacher/judge constructors. Backend classes never
# read the environment themselves.

# Cloud APIs (unused in iteration 0 stubs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional Ollama override (host still primarily comes from YAML)
OLLAMA_HOST=http://localhost:11434
